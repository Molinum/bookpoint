            "pm.collectionVariables.set('clienteId', json.id);",
            "pm.test('La contraseña no viene en la respuesta', () => {",
            "  pm.expect(json.password).to.be.undefined;",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan.perez@example.com\",\n  \"direccion\": \"Av. Siempre Viva 123\",\n  \"comuna\": \"Providencia\",\n  \"password\": \"MiClaveSegura123\"\n}" },
            "url": { "raw": "{{clientes_url}}", "host": ["{{clientes_url}}"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('clienteToken', json.token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"MiClaveSegura123\"\n}" },
            "url": { "raw": "{{clientes_url}}/login", "host": ["{{clientes_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login con contraseña incorrecta (401 esperado)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"claveIncorrecta\"\n}" },
            "url": { "raw": "{{clientes_url}}/login", "host": ["{{clientes_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Listar Clientes",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": { "raw": "{{clientes_url}}", "host": ["{{clientes_url}}"] } }
        },
        {
          "name": "Obtener Cliente por ID",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": { "raw": "{{clientes_url}}/{{clienteId}}", "host": ["{{clientes_url}}"], "path": ["{{clienteId}}"] } }
        },
        {
          "name": "Actualizar Cliente sin token (401 esperado)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan Pérez Soto\",\n  \"email\": \"juan.perez@example.com\",\n  \"direccion\": \"Av. Siempre Viva 456\",\n  \"comuna\": \"Providencia\"\n}" },
            "url": { "raw": "{{clientes_url}}/{{clienteId}}", "host": ["{{clientes_url}}"], "path": ["{{clienteId}}"] }
          }
        },
        {
          "name": "Actualizar Cliente (con token propio)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clienteToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan Pérez Soto\",\n  \"email\": \"juan.perez@example.com\",\n  \"direccion\": \"Av. Siempre Viva 456\",\n  \"comuna\": \"Providencia\"\n}" },
            "url": { "raw": "{{clientes_url}}/{{clienteId}}", "host": ["{{clientes_url}}"], "path": ["{{clienteId}}"] }
          }
        },
        {
          "name": "Eliminar Cliente (ejecutar al final, rompe la cadena)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{clienteToken}}" }],
            "url": { "raw": "{{clientes_url}}/{{clienteId}}", "host": ["{{clientes_url}}"], "path": ["{{clienteId}}"] }
          }
        }
      ]
    },
    {
