            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{inventario_url}}/descontar?libroId={{libroId}}&sucursal=Santiago Centro&cantidad=1",
              "host": ["{{inventario_url}}"],
              "path": ["descontar"],
              "query": [
                { "key": "libroId", "value": "{{libroId}}" },
                { "key": "sucursal", "value": "Santiago Centro" },
                { "key": "cantidad", "value": "1" }
              ]
            }
          }
        }
      ]
